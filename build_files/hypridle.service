[Unit]
Description=hypridle idle daemon (Tilefin)
Documentation=https://wiki.hypr.land/Hypr-Ecosystem/hypridle/
# Started by graphical-session.target, which niri-session activates
# (§spec:session-targets). PartOf ties teardown to the same target, so the
# daemon stops with the session. See SPEC.md §spec:auto-suspend and
# §spec:hypridle-user-service.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/hypridle

[Install]
WantedBy=graphical-session.target
